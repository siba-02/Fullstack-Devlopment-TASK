<!-- views/index.ejs - Task 5: API Integration -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="container">
        <div class="card">
            
            <!-- Header -->
            <div class="card-header">
                <h1><i class="fas fa-code-branch"></i> Task 5: API Integration</h1>
                <p class="subtitle">
                    <i class="fas fa-plug"></i> 
                    RESTful API with CRUD operations & Front-End Interaction
                </p>
            </div>
            
            <div class="card-body">
                
                <!-- Message -->
                <div id="messageContainer"></div>
                
                <!-- ============================================= -->
                <!-- TWO COLUMN LAYOUT -->
                <!-- ============================================= -->
                <div class="two-column">
                    
                    <!-- LEFT: Create Todo Form -->
                    <div>
                        <h3><i class="fas fa-plus-circle" style="color: var(--primary);"></i> Create Todo</h3>
                        
                        <form id="todoForm">
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-heading"></i> Title <span class="required">*</span>
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="titleInput"
                                       placeholder="Enter todo title (min 3 chars)"
                                       required>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-align-left"></i> Description
                                </label>
                                <textarea class="form-control" 
                                          id="descInput"
                                          rows="3" 
                                          placeholder="Enter description (optional)"></textarea>
                            </div>
                            
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add Todo
                            </button>
                        </form>
                        
                        <!-- API Testing Section -->
                        <div style="margin-top: 25px; padding-top: 20px; border-top: 2px dashed #e2e8f0;">
                            <h4><i class="fas fa-flask"></i> API Test</h4>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                <button onclick="testGetAll()" class="btn btn-sm btn-outline">
                                    <i class="fas fa-download"></i> GET All
                                </button>
                                <button onclick="testGetOne()" class="btn btn-sm btn-outline">
                                    <i class="fas fa-search"></i> GET One
                                </button>
                                <button onclick="testUpdate()" class="btn btn-sm btn-outline">
                                    <i class="fas fa-edit"></i> PUT
                                </button>
                                <button onclick="testDelete()" class="btn btn-sm btn-outline">
                                    <i class="fas fa-trash"></i> DELETE
                                </button>
                            </div>
                            <div id="apiResponse" style="margin-top: 10px; background: #f7fafc; padding: 12px; border-radius: 8px; font-size: 13px; max-height: 150px; overflow: auto; white-space: pre-wrap; word-break: break-all; color: #4a5568;">
                                <span style="color: #a0aec0;">API responses will appear here...</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- RIGHT: Todo List -->
                    <div>
                        <div class="section-header">
                            <h2><i class="fas fa-list-check"></i> Todo List</h2>
                            <span class="badge" id="todoCount"><%= todos.length %></span>
                        </div>
                        
                        <div id="todosContainer">
                            <% if (todos.length === 0) { %>
                                <div class="no-data">
                                    <i class="fas fa-clipboard-list"></i>
                                    <p>No todos yet. Create one!</p>
                                </div>
                            <% } else { %>
                                <div id="todosList">
                                    <% todos.forEach(todo => { %>
                                        <div class="todo-item" data-id="<%= todo.id %>">
                                            <div class="todo-content">
                                                <div class="todo-check">
                                                    <input type="checkbox" 
                                                           <%= todo.completed ? 'checked' : '' %> 
                                                           onchange="toggleTodo(<%= todo.id %>)">
                                                </div>
                                                <div class="todo-info">
                                                    <div class="todo-title <%= todo.completed ? 'completed' : '' %>">
                                                        <%= todo.title %>
                                                    </div>
                                                    <% if (todo.description) { %>
                                                        <div class="todo-desc"><%= todo.description %></div>
                                                    <% } %>
                                                    <div class="todo-meta">
                                                        <i class="far fa-clock"></i> 
                                                        <%= new Date(todo.createdAt).toLocaleDateString() %>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="todo-actions">
                                                <button onclick="editTodo(<%= todo.id %>)" class="btn-icon edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button onclick="deleteTodo(<%= todo.id %>)" class="btn-icon delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    
                </div>
                
                <!-- Footer -->
                <div class="footer">
                    <p>
                        <strong>Cognifyz Technologies</strong> &bull; 
                        Task 5 - API Integration &amp; Front-End Interaction
                    </p>
                </div>
                
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- ===== JAVASCRIPT - API Integration ===== -->
    <!-- ============================================================ -->
    <script>
        // ============================================
        // TASK 5: API Integration with Front-End
        // ============================================
        
        const API_BASE = '/api';
        
        // ============================================
        // DOM HELPERS
        // ============================================
        
        function showMessage(message, type = 'success') {
            const container = document.getElementById('messageContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            
            container.innerHTML = `
                <div class="alert ${alertClass}">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i>
                    <div><strong>${message}</strong></div>
                </div>
            `;
            
            setTimeout(() => {
                container.innerHTML = '';
            }, 3000);
        }
        
        function updateTodoCount() {
            const count = document.querySelectorAll('.todo-item').length;
            document.getElementById('todoCount').textContent = count;
        }
        
        // ============================================
        // CRUD OPERATIONS (Front-End)
        // ============================================
        
        // CREATE Todo
        document.getElementById('todoForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const title = document.getElementById('titleInput').value.trim();
            const description = document.getElementById('descInput').value.trim();
            
            if (title.length < 3) {
                showMessage('Title must be at least 3 characters', 'error');
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE}/todos`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, description })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showMessage('✅ Todo created successfully!');
                    this.reset();
                    loadTodos(); // Refresh the list
                } else {
                    showMessage(data.message, 'error');
                }
            } catch (error) {
                showMessage('Error: ' + error.message, 'error');
            }
        });
        
        // READ - Load all todos
        async function loadTodos() {
            try {
                const response = await fetch(`${API_BASE}/todos`);
                const data = await response.json();
                
                if (data.success) {
                    renderTodos(data.data);
                }
            } catch (error) {
                console.error('Error loading todos:', error);
            }
        }
        
        // Render todos dynamically
        function renderTodos(todos) {
            const container = document.getElementById('todosContainer');
            
            if (todos.length === 0) {
                container.innerHTML = `
                    <div class="no-data">
                        <i class="fas fa-clipboard-list"></i>
                        <p>No todos yet. Create one!</p>
                    </div>
                `;
                return;
            }
            
            let html = '<div id="todosList">';
            todos.forEach(todo => {
                html += `
                    <div class="todo-item" data-id="${todo.id}">
                        <div class="todo-content">
                            <div class="todo-check">
                                <input type="checkbox" 
                                       ${todo.completed ? 'checked' : ''} 
                                       onchange="toggleTodo(${todo.id})">
                            </div>
                            <div class="todo-info">
                                <div class="todo-title ${todo.completed ? 'completed' : ''}">
                                    ${todo.title}
                                </div>
                                ${todo.description ? `<div class="todo-desc">${todo.description}</div>` : ''}
                                <div class="todo-meta">
                                    <i class="far fa-clock"></i> 
                                    ${new Date(todo.createdAt).toLocaleDateString()}
                                </div>
                            </div>
                        </div>
                        <div class="todo-actions">
                            <button onclick="editTodo(${todo.id})" class="btn-icon edit">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteTodo(${todo.id})" class="btn-icon delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            
            container.innerHTML = html;
            updateTodoCount();
        }
        
        // UPDATE - Toggle completion
        async function toggleTodo(id) {
            try {
                const response = await fetch(`${API_BASE}/todos/${id}/toggle`, {
                    method: 'PATCH'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    loadTodos(); // Refresh
                    showMessage(data.message);
                }
            } catch (error) {
                showMessage('Error: ' + error.message, 'error');
            }
        }
        
        // UPDATE - Edit todo (inline)
        async function editTodo(id) {
            const todoItem = document.querySelector(`.todo-item[data-id="${id}"]`);
            const titleDiv = todoItem.querySelector('.todo-title');
            const currentTitle = titleDiv.textContent.trim();
            
            // Show edit prompt
            const newTitle = prompt('Edit todo title:', currentTitle);
            if (newTitle === null) return; // Cancel
            
            if (newTitle.trim().length < 3) {
                showMessage('Title must be at least 3 characters', 'error');
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE}/todos/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: newTitle.trim() })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showMessage('✅ Todo updated successfully!');
                    loadTodos();
                }
            } catch (error) {
                showMessage('Error: ' + error.message, 'error');
            }
        }
        
        // DELETE - Delete todo
        async function deleteTodo(id) {
            if (!confirm('Are you sure you want to delete this todo?')) return;
            
            try {
                const response = await fetch(`${API_BASE}/todos/${id}`, {
                    method: 'DELETE'
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showMessage('✅ Todo deleted successfully!');
                    loadTodos();
                }
            } catch (error) {
                showMessage('Error: ' + error.message, 'error');
            }
        }
        
        // ============================================
        // API TEST FUNCTIONS
        // ============================================
        
        function showApiResponse(data) {
            document.getElementById('apiResponse').textContent = JSON.stringify(data, null, 2);
        }
        
        async function testGetAll() {
            try {
                const response = await fetch(`${API_BASE}/todos`);
                const data = await response.json();
                showApiResponse(data);
            } catch (error) {
                showApiResponse({ error: error.message });
            }
        }
        
        async function testGetOne() {
            const id = prompt('Enter todo ID:');
            if (!id) return;
            
            try {
                const response = await fetch(`${API_BASE}/todos/${id}`);
                const data = await response.json();
                showApiResponse(data);
            } catch (error) {
                showApiResponse({ error: error.message });
            }
        }
        
        async function testUpdate() {
            const id = prompt('Enter todo ID to update:');
            if (!id) return;
            
            const title = prompt('Enter new title:');
            if (!title) return;
            
            try {
                const response = await fetch(`${API_BASE}/todos/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title })
                });
                const data = await response.json();
                showApiResponse(data);
                if (data.success) loadTodos();
            } catch (error) {
                showApiResponse({ error: error.message });
            }
        }
        
        async function testDelete() {
            const id = prompt('Enter todo ID to delete:');
            if (!id) return;
            
            if (!confirm('Delete this todo?')) return;
            
            try {
                const response = await fetch(`${API_BASE}/todos/${id}`, {
                    method: 'DELETE'
                });
                const data = await response.json();
                showApiResponse(data);
                if (data.success) loadTodos();
            } catch (error) {
                showApiResponse({ error: error.message });
            }
        }
        
        // ============================================
        // INITIAL LOAD
        // ============================================
        
        console.log('📋 Task 5: API Integration is ACTIVE!');
        console.log('📡 API Base URL:', API_BASE);
        console.log('🔄 CRUD operations available:');
        console.log('   - Create: Form submission');
        console.log('   - Read: Auto-loaded on page');
        console.log('   - Update: Click edit icon or checkbox');
        console.log('   - Delete: Click delete icon');
    </script>

</body>
</html>